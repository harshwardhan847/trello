// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(uuid())
  email          String
  password       String
  memberships    Membership[]
  issuesMappings IssuesMapping[]
}

model Org {
  id          String       @id @default(uuid())
  name        String
  description String
  memberships Membership[]
  boards      Boards[]
}

model Membership {
  user   User   @relation(fields: [userId], references: [id])
  userId String
  org    Org    @relation(fields: [orgId], references: [id])
  orgId  String

  @@id([orgId, userId])
}

model Boards {
  id       String     @id @default(uuid())
  title    String
  orgId    String
  org      Org        @relation(fields: [orgId], references: [id])
  issues   Issues[]
  sections Sections[]
}

model Sections {
  id      String   @id @default(uuid())
  title   String
  board   Boards   @relation(fields: [boardId], references: [id])
  boardId String
  issues  Issues[]
}

model Issues {
  id             String          @id @default(uuid())
  title          String
  description    String?
  boardId        String
  board          Boards          @relation(fields: [boardId], references: [id])
  sectionId      String
  section        Sections        @relation(fields: [sectionId], references: [id])
  comments       Comments[]
  issuesMappings IssuesMapping[]
}

model Comments {
  id      String @id @default(uuid())
  message String
  issueId String
  issue   Issues @relation(fields: [issueId], references: [id])
}

model IssuesMapping {
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  issueId String
  issue   Issues @relation(fields: [issueId], references: [id])

  @@id([userId, issueId])
}
